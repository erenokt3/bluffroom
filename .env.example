# BluffRoom Environment Variables

# --- Sunucu & Oturum Güvenliği (Zorunlu) ---
# En az 32 karakterlik rastgele bir sır dizesi (örn: openssl rand -base64 32)
SESSION_SECRET=your-random-32-char-session-secret-change-this-in-production

# --- Supabase Veritabanı ve Realtime (Vercel Dağıtımı İçin) ---
# Yerel test ve geliştirmede boş bırakılırsa gömülü PGlite (WASM Postgres) kullanılır.
# Vercel üzerinde Transaction Pooler bağlantı URL'si (port 6543) gereklidir.
DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Realtime & İstemci Ayarları
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Yapay Zekâ Soru Servisi (İsteğe Bağlı) ---
# Belirtilmezse sistem otomatik olarak 80+ soruluk zengin Türkçe soru havuzunu kullanır ve oyun asla aksamaz.
# Desteklenen sağlayıcılar: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your-gemini-or-openai-api-key

# --- Cron Temizleme Anahtarı (İsteğe Bağlı) ---
# Vercel Cron ile terk edilmiş odaları temizlemek için
CRON_SECRET=your-optional-cron-secret
